# Copy to .env (gitignored) and fill in. Names only here; never commit values.

# One block per role: AGENT, EXTRACTOR, COMPRESSOR, JUDGE
AGENT_ENDPOINT=
AGENT_API_KEY=
AGENT_DEPLOYMENT=gpt-5.6-sol
AGENT_API_VERSION=2025-04-01-preview

EXTRACTOR_ENDPOINT=
EXTRACTOR_API_KEY=
EXTRACTOR_DEPLOYMENT=gpt-5.4-mini
EXTRACTOR_API_VERSION=2025-04-01-preview

COMPRESSOR_ENDPOINT=
COMPRESSOR_API_KEY=
COMPRESSOR_DEPLOYMENT=gpt-5.4-nano
COMPRESSOR_API_VERSION=2025-04-01-preview

JUDGE_ENDPOINT=
JUDGE_API_KEY=
JUDGE_DEPLOYMENT=gpt-5
JUDGE_API_VERSION=2025-04-01-preview

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Behaviour and limits
COMPRESS_THRESHOLD=5
ASK_BUDGET=3
MAX_TOOL_CALLS_PER_TURN=12
SESSION_MAX_MODEL_CALLS=60
SESSION_MAX_TOKENS=150000
IP_MAX_SESSIONS_PER_DAY=3
DAILY_BUDGET_SWITCH=on
INVITE_CODE=
